[Unit]
Description=wist-evidence (evidence service: index / authz / presign / retention)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 不需要 root：读写对象存储走环境里的凭据，索引走 PG，磁盘只用于读配置。
User=wisteve
Group=wisteve

# 配置与密钥同一口径（与 center / gwlinkd / ingest-ctrl 一致）：
#   /etc/wist-evidence/wist-evidence.toml         ← 现场态，0640
#   /etc/wist-evidence/.wist/sec-value.yml        ← ${SEC_...} 的真值，0640
Environment=WIST_EVIDENCE_CONFIG=/etc/wist-evidence/wist-evidence.toml
Environment=WIST_EVIDENCE_SEC_FILE=/etc/wist-evidence/.wist/sec-value.yml
# 非密钥的现场覆盖（可选）：纯文本 KV，不要把 token 放这里。
EnvironmentFile=-/etc/wist-evidence/wist-evidence.env

ExecStart=/usr/local/bin/wist-evidence
Restart=on-failure
RestartSec=3

# 证据正文的落点（`objects.kind = file`）：systemd 会建好 /var/lib/wist-evidence 并授权给 wisteve。
# 配置里请写 `[objects] kind = "file"` + `dir = "/var/lib/wist-evidence/objects"`；
# 切 COS（`kind = "s3"`）后本机不再写盘，这两行保留也无害。
StateDirectory=wist-evidence
StateDirectoryMode=0750
WorkingDirectory=/var/lib/wist-evidence

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/wist-evidence
# 对象目录是唯一需要写的地方（StateDirectory 已包含在可写集合里）。
ReadWritePaths=/var/lib/wist-evidence

[Install]
WantedBy=multi-user.target
